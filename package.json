{
  "name": "deejazz",
  "productName": "DeeJazz",
  "version": "1.1.0",
  "private": true,
  "description": "DeeJazz desktop application with uBO Lite integration",
  "license": "UNLICENSED",
  "author": "DeeJazz contributors",
  "main": "build/main-with-ubol.js",
  "scripts": {
    "version:sync": "node scripts/sync-version.js",
    "app:integrate": "node scripts/apply-application-integration.js",
    "runtime:brand": "node scripts/brand-windows-runtime.js",
    "icons:win": "node scripts/generate-windows-icon.js",
    "dist:win": "npm run version:sync && npm run icons:win && npm run app:integrate && node scripts/build-windows-installer.js",
    "dist:linux": "npm run version:sync && npm run app:integrate && node scripts/build-linux-portable.js --arch=x64",
    "dist:linux:arm64": "npm run version:sync && npm run app:integrate && node scripts/build-linux-portable.js --arch=arm64"
  },
  "build": {
    "appId": "com.deejazz.desktop",
    "productName": "DeeJazz",
    "electronVersion": "38.4.0",
    "directories": {
      "buildResources": "src/resources/win",
      "output": "dist"
    },
    "win": {
      "executableName": "DeeJazz",
      "icon": "src/resources/win/app.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerHeader": null,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeeJazz",
      "uninstallDisplayName": "DeeJazz",
      "artifactName": "deejazz-windows-x64.${ext}"
    }
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@jellybrick/mpris-service": "2.1.5",
    "electron-builder": "26.15.3",
    "resedit": "1.7.2"
  }
}
