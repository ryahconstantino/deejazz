{
  "name": "deejazz",
  "productName": "DeeJazz",
  "version": "1.3.6",
  "private": true,
  "description": "DeeJazz",
  "license": "MIT",
  "author": "Ryan Constantino",
  "main": "build/main-with-ubol.js",
  "scripts": {
    "version:sync": "node scripts/sync-version.js",
    "test:installer": "node --test scripts/tests/install-linux.test.js",
    "test:updater": "node --test scripts/tests/auto-update.test.js scripts/tests/android-auto-update.test.js",
    "app:integrate": "node scripts/apply-application-integration.js",
    "runtime:brand": "node scripts/brand-windows-runtime.js",
    "icons:win": "node scripts/generate-windows-icon.js",
    "icons:android": "node scripts/generate-android-branding.js",
    "check:android": "node scripts/verify-android-source.js",
    "test:android-ui": "node --test scripts/tests/android-ui.test.js",
    "dist:android": "npm run icons:android && node scripts/build-android.js",
    "dist:win": "npm run version:sync && npm run icons:win && npm run app:integrate && node scripts/build-windows-installer.js",
    "dist:linux": "npm run version:sync && npm run app:integrate && node scripts/build-linux-portable.js --arch=x64",
    "dist:linux:arm64": "npm run version:sync && npm run app:integrate && node scripts/build-linux-portable.js --arch=arm64"
  },
  "build": {
    "appId": "com.deejazz.desktop",
    "productName": "DeeJazz",
    "electronVersion": "38.4.0",
    "directories": {
      "buildResources": "desktop/resources/win",
      "output": "dist"
    },
    "win": {
      "executableName": "DeeJazz",
      "icon": "desktop/resources/win/app.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerHeader": null,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeeJazz",
      "uninstallDisplayName": "DeeJazz",
      "artifactName": "deejazz-windows-x64-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/get": "^3.1.0",
    "@jellybrick/mpris-service": "2.1.5",
    "electron-builder": "26.15.3",
    "resedit": "1.7.2",
    "sharp": "0.35.3",
    "unzipper": "^0.12.5"
  }
}
