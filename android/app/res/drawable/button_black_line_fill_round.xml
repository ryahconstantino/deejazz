<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="?colorControlHighlight"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/palette_black" />
            <corners android:radius="@dimen/radius_round" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true" android:drawable="@drawable/button_round_black_pressed" />
            <item android:state_enabled="true" android:drawable="@drawable/button_round_black_enabled" />
            <item android:state_enabled="false" android:drawable="@drawable/button_round_black_disabled" />
        </selector>
    </item>
</ripple>
