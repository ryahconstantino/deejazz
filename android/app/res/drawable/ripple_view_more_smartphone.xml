<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="@color/theme_bg_contrast"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/scaled_20dp" />
            <stroke android:width="1.0dp" android:color="@color/theme_divider_primary" />
            <solid android:color="@color/theme_bg_contrast" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/scaled_20dp" />
            <stroke android:width="1.0dp" android:color="@color/theme_divider_primary" />
            <solid android:color="@color/theme_bg_contrast" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/scaled_20dp" />
            <stroke android:width="1.0dp" android:color="@color/theme_divider_primary" />
            <solid android:color="@color/view_all_background" />
        </shape>
    </item>
</ripple>
