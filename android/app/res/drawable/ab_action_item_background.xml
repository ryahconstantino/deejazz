<?xml version="1.0" encoding="utf-8"?>
<selector android:variablePadding="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_enabled="true" android:state_pressed="false">
        <shape>
            <solid android:color="@color/list_item_selector_enabled" />
        </shape>
    </item>
    <item android:state_enabled="true" android:state_pressed="true">
        <shape>
            <solid android:color="@color/list_item_selector_enabled" />
        </shape>
    </item>
    <item android:state_focused="true" android:state_enabled="false" android:state_pressed="false">
        <shape>
            <solid android:color="@color/list_item_selector_disabled" />
        </shape>
    </item>
    <item android:state_enabled="false" android:state_pressed="true">
        <shape>
            <solid android:color="@color/list_item_selector_disabled" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
