<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <ripple android:color="?colorControlHighlight">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/theme_error_primary" />
                    <corners android:radius="@dimen/button_corner_radius_mat" />
                </shape>
            </item>
        </ripple>
    </item>
    <item android:state_enabled="false" android:drawable="@drawable/ripple_deezer_grey" />
</selector>
