<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <size android:width="@dimen/fastscroll_handleline_thickness__pressed" />
            <solid android:color="@color/grey_mat_pressed" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <size android:width="@dimen/fastscroll_handleline_thickness__pressed" />
            <solid android:color="@color/grey_mat_pressed" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="@dimen/fastscroll_handleline_thickness" />
            <solid android:color="@color/grey_mat_pressed" />
        </shape>
    </item>
</selector>
