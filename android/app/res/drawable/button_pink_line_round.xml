<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="?colorControlHighlight"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/legacy_brand_pink_100_opacity_60" />
            <corners android:radius="@dimen/radius_round" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true" android:drawable="@drawable/button_pink_line_round_pressed" />
            <item android:state_enabled="true" android:drawable="@drawable/button_pink_line_round_enabled" />
        </selector>
    </item>
</ripple>
