<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/theme_accent_secondary" />
            <corners android:radius="16.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/theme_accent_secondary" />
            <corners android:radius="16.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/theme_accent_primary" />
            <corners android:radius="16.0dp" />
        </shape>
    </item>
</selector>
