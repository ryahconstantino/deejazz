<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadiusRatio="2.5" android:useLevel="false" android:thickness="3.0dp">
            <solid android:color="@color/palette_light_grey_300" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:toDegrees="360.0">
            <shape android:shape="ring" android:innerRadiusRatio="2.5" android:useLevel="false" android:thickness="3.0dp">
                <gradient android:startColor="@android:color/transparent" android:endColor="@android:color/black" android:angle="0.0" android:type="sweep" />
            </shape>
        </rotate>
    </item>
</layer-list>
